<?xml version="1.0" encoding="utf-8"?>
<!--
  Two deliberate choices, both because this app only ever talks to the operator's own
  self-hosted Agentus server:

  * cleartext is OFF by default and only allowed for the LAN addresses (a test bed over
    http://192.168.x.x). Everything else must be wss/https.
  * https to a self-signed issuer is handled in code (Http.java pins the bundled CA and
    accepts it for whatever host the operator typed) — the cert is issued for a DDNS name,
    which a LAN IP is not, so system trust + hostname verification cannot be used as-is.
-->
<network-security-config>
    <!--
      The user store is declared here as well as merged in code (Http.java), because the two cover
      different callers: anything the platform validates for this app (WebView, the download
      manager, an OkHttp call built without our factory) reads THIS, while the app's own client
      reads the merged store. Since Android 7 a third-party app's default chain leaves user-added
      CAs out — the browser does not, which is why a private root can be "fine in Chrome" and a
      trust-anchor failure here. Additive only: the system roots stay trusted either way.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.0.109</domain>
        <domain includeSubdomains="false">192.168.0.108</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>